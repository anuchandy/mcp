<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- The configuration binding generator emits code that calls obsolete X509Certificate2 members,
         producing SYSLIB0026/0027/0028 in the generated .g.cs file. SuppressMessage cannot reach
         generated code, so NoWarn in the csproj is the only suppression mechanism available.
         (SYSLIB1100/1101 are analyzer diagnostics on our source and are handled via SuppressMessage
         in IdWebBinder.cs.) -->
    <NoWarn>$(NoWarn);SYSLIB0026;SYSLIB0027;SYSLIB0028</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Identity.Abstractions" />
  </ItemGroup>
</Project>
